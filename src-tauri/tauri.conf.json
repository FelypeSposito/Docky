{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docky",
  "version": "0.1.0",
  "identifier": "com.docky.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Docky",
        "url": "index.html",
        "width": 720,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Felype Sposito",
    "copyright": "Copyright © 2026 Felype Sposito",
    "category": "Productivity",
    "shortDescription": "Uma ilha dinâmica para o Windows 11",
    "longDescription": "Docky é uma ilha dinâmica para o Windows 11: uma pílula no topo da tela com hora, música com letra sincronizada, atividade do Claude Code, timers, notas, agenda, atalhos e uso do sistema.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
